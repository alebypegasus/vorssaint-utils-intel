{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vorssaint",
  "version": "3.7.8",
  "identifier": "com.vorssaint.utils.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "island",
        "url": "/?window=island",
        "title": "Vorssaint Dynamic Island",
        "width": 276,
        "height": 42,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "panel",
        "url": "/?window=panel",
        "title": "Vorssaint Panel",
        "width": 356,
        "height": 592,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "/?window=settings",
        "title": "Vorssaint Utils",
        "width": 1000,
        "height": 680,
        "minWidth": 772,
        "minHeight": 528,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "/?window=overlay",
        "title": "Vorssaint Overlay",
        "width": 660,
        "height": 490,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
